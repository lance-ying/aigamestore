  "@type": "sc:Dataset",
  "conformsTo": "http://mlcommons.org/croissant/1.0",
  "name": "AI GameStore Study Data",
  "description": "Gameplay sessions, per-session input/score telemetry, and feedback from the AI GameStore user study on Prolific. Restricted to the final 100 AI GameStore games: 2,281 session records from 87 participants covering 99 of the 100 games (no sessions were recorded for PhysiType). Session-level scores and numeric ratings are released for all of these games; raw per-session telemetry and free-text per-game feedback are released only for the 10 public games (aqua-sort-puzzle, fling-feathers-blitz, red-hot-vengeance-web-edition, jetpack-joyride-clone, cheese-chase-mouse-escape, shadow-boy, battle-zone, bubble-cash, megaman, ao-oni-the-mansions-shadow). The other 90 games form the AI GameStore private test set. Companion to the AI GameStore paper (NeurIPS 2026 Evaluations and Datasets Track).",
  "version": "1.2.0",
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "url": "https://github.com/lance-ying/aigamestore",
  "citeAs": "Ying, L., Truong, R., Sharma, P., Zhao, K. I., Cloos, N., Allen, K. R., Griffiths, T. L., Collins, K. M., Hernández-Orallo, J., Isola, P., Gershman, S. J., & Tenenbaum, J. B. (2026). AI GameStore: Scalable, Open-Ended Evaluation of Machine General Intelligence with Human Games. NeurIPS 2026 Evaluations and Datasets Track. arXiv:2602.17594.",
  "creator": [
    {
      "@type": "sc:Person",
      "name": "Lance Ying"
    },
    {
      "@type": "sc:Person",
      "name": "Ryan Truong"
    },
    {
      "@type": "sc:Person",
      "name": "Prafull Sharma"
    },
    {
      "@type": "sc:Person",
      "name": "Kaiya Ivy Zhao"
    },
    {
      "@type": "sc:Person",
      "name": "Nathan Cloos"
    },
    {
      "@type": "sc:Person",
      "name": "Kelsey R. Allen"
    },
    {
      "@type": "sc:Person",
      "name": "Thomas L. Griffiths"
    },
    {
      "@type": "sc:Person",
      "name": "Katherine M. Collins"
    },
    {
      "@type": "sc:Person",
      "name": "José Hernández-Orallo"
    },
    {
      "@type": "sc:Person",
      "name": "Phillip Isola"
    },
    {
      "@type": "sc:Person",
      "name": "Samuel J. Gershman"
    },
    {
      "@type": "sc:Person",
      "name": "Joshua B. Tenenbaum"
    }
  ],
  "keywords": [
    "human-computer interaction",
    "user study",
    "LLM-generated games",
    "gameplay telemetry",
    "browser games"
  ],
  "isLiveDataset": false,
  "rai:dataCollection": "Participants were recruited through Prolific and played a sequence of LLM-generated HTML5 games in a browser-based study. Per-session input event streams, score time-series, and metadata were captured client-side via the participant frontend (see ../frontend/) and persisted to Firebase Firestore + Storage. Per-game feedback was collected immediately after each game; an end-of-study survey collected demographics and free-text feedback.",
  "rai:dataCollectionType": [
    "Crowdsourced",
    "User study"
  ],
  "rai:dataAnnotationProtocol": "Self-reported by participants via in-app forms (per-game ratings; end-of-study free-text and demographic categorical fields). No external annotators.",
  "rai:dataPreprocessingProtocol": [
    "Pre-launch test sessions from research-team accounts (non-Prolific-format user IDs) were removed.",
    "Verbose runtime debug logs (~189 MB) were excluded.",
    "Firebase Storage URLs in session records were nulled out; corresponding files are bundled in this release.",
    "Prolific IDs replaced with pseudonymous participant codes (P###) in all file contents and paths.",
    "deviceInfo removed from all session records and metadata.",
    "For the 90 private-test-set games, raw per-session telemetry (inputs, metadata, score files) and free-text per-game feedback were withheld; session-level final scores, score time-series in gameplay_sessions.json, and numeric per-game ratings are retained.",
    "Missing keys were made explicit as null (gameplay_sessions.score; inputs events key/x/y) so every record has the same fields.",
    "Restricted to the final 100 AI GameStore games: sessions and per-game feedback for game variants and for games cut from the final set were removed, along with end-of-study surveys from participants who played only those games."
  ],
  "rai:personalSensitiveInformation": "Prolific participant IDs were replaced with pseudonymous codes (P001, P002, ...) that are consistent across all files; the original Prolific IDs are not released. Device information (user agent, timezone, screen size, platform) was removed. Self-reported demographic fields (age band, gender, gaming frequency, gaming experience) are released with participant consent. No direct identifiers (names, emails, IP addresses) are present.",
  "rai:dataReleaseMaintenancePlan": "Static research artifact. Errata and corrections, if any, will be published alongside the dataset.",
  "rai:dataUseCases": [
    "Quantitative analysis of human gameplay behavior on LLM-generated games",
    "Modeling player engagement, score progression, and game completion",
    "Reference for LLM game-generation and game-playability evaluation"
  ],
  "rai:dataLimitations": [
    "Participants are sampled from Prolific and skew toward English-speaking, gaming-experienced adults.",
    "Only the 10 public games ship with the companion frontend; the other 90 games are a private test set and are not distributed.",
    "Score semantics are game-specific; cross-game score comparisons are not meaningful without per-game normalization.",
    "Feedback is self-report and subject to standard self-report biases."
  ],
  "rai:dataSocialImpact": "Intended for HCI and ML research on LLM-generated interactive content. Demographic distributions reflect Prolific's pool composition, not the general population.",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "github-repository",
      "name": "github-repository",
      "description": "AI GameStore GitHub repository.",
      "contentUrl": "https://github.com/lance-ying/aigamestore",
      "encodingFormat": "git+https",
      "sha256": "main"
    },
    {
      "@type": "cr:FileObject",
      "@id": "users-json",
      "name": "users.json",
      "description": "Array of 87 participant records.",
      "contentUrl": "https://raw.githubusercontent.com/lance-ying/aigamestore/main/human%20experiment/study_data/firestore/users.json",
      "encodingFormat": "application/json",
      "sha256": "ab97270825d1ee8cc0c53e48f5a62d61a1cc9d06c919355adc008031de2c7d2e"
    },
    {
      "@type": "cr:FileObject",
      "@id": "gameplay-sessions-json",
      "name": "gameplay_sessions.json",
      "description": "Array of 2,281 session records (one per game played by a participant).",
      "contentUrl": "https://raw.githubusercontent.com/lance-ying/aigamestore/main/human%20experiment/study_data/firestore/gameplay_sessions.json",
      "encodingFormat": "application/json",
      "sha256": "ced32b698a6136828d0d0a382be8557cad8a545ce0c20f4299ad6a2bdef7c1c7"
    },
    {
      "@type": "cr:FileSet",
      "@id": "session-inputs-files",
      "name": "session-inputs",
      "description": "Per-session input event streams (mouse + keyboard). Released for the 10 public games only.",
      "encodingFormat": "application/json",
      "includes": "human experiment/study_data/sessions/*/user_sessions/*/*/inputs.json",
      "containedIn": {
        "@id": "github-repository"
      }
    },
    {
      "@type": "cr:FileSet",
      "@id": "session-scores-files",
      "name": "session-scores",
      "description": "Per-session score time-series and final score. Released for the 10 public games only.",
      "encodingFormat": "application/json",
      "includes": "human experiment/study_data/sessions/*/user_sessions/*/*/scores.json",
      "containedIn": {
        "@id": "github-repository"
      }
    },
    {
      "@type": "cr:FileSet",
      "@id": "session-metadata-files",
      "name": "session-metadata",
      "description": "Per-session metadata (game ID, user ID, start/end time, fps). Released for the 10 public games only.",
      "encodingFormat": "application/json",
      "includes": "human experiment/study_data/sessions/*/user_sessions/*/*/metadata.json",
      "containedIn": {
        "@id": "github-repository"
      }
    },
    {
      "@type": "cr:FileSet",
      "@id": "per-game-feedback-files",
      "name": "per-game-feedback",
      "description": "Per-game feedback submitted by participants immediately after each game (889 files). Free-text feedback (textFeedback) is included for the 10 public games only.",
      "encodingFormat": "application/json",
      "includes": "human experiment/study_data/feedback/per_game/**/feedback.json",
      "containedIn": {
        "@id": "github-repository"
      }
    },
    {
      "@type": "cr:FileSet",
      "@id": "end-study-feedback-files",
      "name": "end-study-feedback",
      "description": "End-of-study survey responses including demographics and free-text feedback (77 files).",
      "encodingFormat": "application/json",
      "includes": "human experiment/study_data/feedback/end_study/*/feedback.json",
      "containedIn": {
        "@id": "github-repository"
      }
    }
  ],
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "@id": "users",
      "name": "users",
      "description": "Participant records. One per participant (pseudonymous code).",
      "key": {
        "@id": "users/userId"
      },
      "field": [
        {
          "@type": "cr:Field",
          "@id": "users/id",
          "name": "id",
          "description": "Same value as userId.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "users-json"
            },
            "extract": {
              "jsonPath": "$[*].id"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "users/userId",
          "name": "userId",
          "description": "Prolific participant ID (24-character hex). Pseudonymous.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "users-json"
            },
            "extract": {
              "jsonPath": "$[*].userId"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "users/totalSessions",
          "name": "totalSessions",
          "description": "Number of sessions recorded for this participant in users.json (note: cross-check against gameplay_sessions.json for ground-truth count).",
          "dataType": "sc:Integer",
          "source": {
            "fileObject": {
              "@id": "users-json"
            },
            "extract": {
              "jsonPath": "$[*].totalSessions"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "users/gamesPlayed",
          "name": "gamesPlayed",
          "description": "List of game IDs (`all_92_games/<slug>`) the participant played.",
          "dataType": "sc:Text",
          "repeated": true,
          "source": {
            "fileObject": {
              "@id": "users-json"
            },
            "extract": {
              "jsonPath": "$[*].gamesPlayed"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "users/createdAt_seconds",
          "name": "createdAt_seconds",
          "description": "Account creation Unix timestamp (seconds).",
          "dataType": "sc:Integer",
          "source": {
            "fileObject": {
              "@id": "users-json"
            },
            "extract": {
              "jsonPath": "$[*].createdAt._seconds"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "users/lastActiveAt_seconds",
          "name": "lastActiveAt_seconds",
          "description": "Last active Unix timestamp (seconds).",
          "dataType": "sc:Integer",
          "source": {
            "fileObject": {
              "@id": "users-json"
            },
            "extract": {
              "jsonPath": "$[*].lastActiveAt._seconds"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "gameplay_sessions",
      "name": "gameplay_sessions",
      "description": "One record per game played. 2,281 records total.",
      "key": {
        "@id": "gameplay_sessions/sessionId"
      },
      "field": [
        {
          "@type": "cr:Field",
          "@id": "gameplay_sessions/sessionId",
          "name": "sessionId",
          "description": "`session_<timestamp>_<rand>`.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "gameplay-sessions-json"
            },
            "extract": {
              "jsonPath": "$[*].sessionId"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "gameplay_sessions/userId",
          "name": "userId",
          "description": "Prolific participant ID. Foreign key to users.userId.",
          "dataType": "sc:Text",
          "references": {
            "field": {
              "@id": "users/userId"
            }
          },
          "source": {
            "fileObject": {
              "@id": "gameplay-sessions-json"
            },
            "extract": {
              "jsonPath": "$[*].userId"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "gameplay_sessions/gameId",
          "name": "gameId",
          "description": "`all_92_games/<slug>`. Strip the `all_92_games/` prefix to align with sessions/ directory layout.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "gameplay-sessions-json"
            },
            "extract": {
              "jsonPath": "$[*].gameId"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "gameplay_sessions/duration",
          "name": "duration",
          "description": "Session duration in seconds.",
          "dataType": "sc:Integer",
          "source": {
            "fileObject": {
              "@id": "gameplay-sessions-json"
            },
            "extract": {
              "jsonPath": "$[*].duration"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "gameplay_sessions/completed",
          "name": "completed",
          "description": "Whether gameplay reached a clean end state.",
          "dataType": "sc:Boolean",
          "source": {
            "fileObject": {
              "@id": "gameplay-sessions-json"
            },
            "extract": {
              "jsonPath": "$[*].completed"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "gameplay_sessions/score",
          "name": "score",
          "description": "Game-specific final score. Not comparable across games without per-game normalization.",
          "dataType": "sc:Integer",
          "source": {
            "fileObject": {
              "@id": "gameplay-sessions-json"
            },
            "extract": {
              "jsonPath": "$[*].score"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "gameplay_sessions/timestamp_seconds",
          "name": "timestamp_seconds",
          "description": "Session timestamp Unix seconds.",
          "dataType": "sc:Integer",
          "source": {
            "fileObject": {
              "@id": "gameplay-sessions-json"
            },
            "extract": {
              "jsonPath": "$[*].timestamp._seconds"
            }
          }
        }
      ]
    },
    {
      "@type": "cr:RecordSet",
      "@id": "session_inputs",
