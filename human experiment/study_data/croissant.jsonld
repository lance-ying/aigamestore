  "sameAs": "https://aigamestore.org",
  "datePublished": "2026-10-27",
  "rai:dataBiases": [
    "Participants were recruited on Prolific and skew toward English-speaking adults with prior gaming experience; the paper's analysis sample is 106 participants (mean age 38.8; 58 male, 46 female, 2 non-binary). Human baselines may therefore overestimate typical novice performance.",
    "Games were sourced from Apple App Store and Steam top charts and filtered for short, keyboard-controlled play, so casual action and puzzle games are over-represented and narrative, simulation, real-time-strategy and long-horizon games are under-represented.",
    "Fun and challenge ratings are subjective self-reports on 0-100 sliders and reflect this participant pool's preferences."
  ],
  "rai:hasSyntheticData": false,
  "prov:wasDerivedFrom": [
    {
      "@id": "https://github.com/lance-ying/aigamestore",
      "name": "AI GameStore games",
      "description": "Gameplay was recorded on the 100 AI GameStore games, which are LLM-generated, human-refined JavaScript adaptations of popular App Store and Steam games. The 10 public games are in the repository; the other 90 are a private test set. The records themselves are human gameplay, not synthetic data."
    }
  ],
  "prov:wasGeneratedBy": [
    {
      "@type": "prov:Activity",
      "name": "Data collection",
      "description": "IRB-approved online study run December 2025 - February 2026. Prolific participants each played 10 randomly assigned games for one 120-second episode per game in a browser frontend (human experiment/frontend). Scores were sampled every 30 frames and keyboard/mouse inputs were logged client-side to Firebase."
    },
    {
      "@type": "prov:Activity",
      "name": "Data annotation",
      "description": "No external annotators. After each game, participants rated fun and challenge (0-100) and similarity to a game they knew; at the end they answered a short survey with demographics and free-text feedback."
    },
    {
      "@type": "prov:Activity",
      "name": "Preprocessing",
      "description": "Pre-launch test sessions removed; debug logs excluded; Prolific IDs replaced with pseudonymous codes; device information removed; raw telemetry and free-text feedback withheld for the 90 private-test-set games; missing keys made explicit as null. See rai:dataPreprocessingProtocol."
    }
  ]
}